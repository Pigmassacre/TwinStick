## The whole way down as a list of levels: {"depth" (index), "stage" (from 0), "boss"}.
static func levels() -> Array:
	var out := []
	for d in LIST.size():
		var depth: Dictionary = LIST[d]
		for s: int in depth.stages:
			out.append({"depth": d, "stage": s, "boss": false})
		out.append({"depth": d, "stage": int(depth.stages), "boss": true})
	return out
